{
  "name": "ejemplos-angular-material",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:vitest": "ng run untitled1:test-vitest --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:cucumber": "cucumber-js cucumber/navigation.feature --require cucumber/e2e-browser.cjs --require features/steps/e2e/navigation.steps.cjs --format progress",
    "test:unit:cucumber": "cucumber-js cucumber/responsive-menu.feature --require features/steps/unit/responsive-menu.steps.cjs",
    "storybook": "ng run untitled1:storybook",
    "build-storybook": "ng run untitled1:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular-devkit/architect": "^0.2202.6",
    "@angular-devkit/core": "^22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "~22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/angular-vite": "^10.6.7",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.6.0",
    "jsdom": "^31.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "storybook": "^10.6.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "latest",
    "vitest": "^5.1.0"
  }
}
